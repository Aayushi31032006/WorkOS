{
  "name": "@cs/contracts",
  "version": "0.1.0",
  "description": "Shared Zod schemas, TypeScript types, events, permissions, and error codes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "rimraf": "6.1.3",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  }
}

