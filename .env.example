# Copy this file to .env and fill in values for local development ONLY.
# NEVER commit .env files. All values here are safe synthetic defaults.

# --- Mock IdP ---------------------------------------------------------------
MOCK_IDP_PORT=4001
MOCK_IDP_ISSUER=http://localhost:4001

# --- API --------------------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0

# --- JWKS -------------------------------------------------------------------
JWKS_URI=http://localhost:4001/.well-known/jwks.json
JWT_AUDIENCE=communication-system
JWT_ISSUER=http://localhost:4001

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://cs_user:cs_pass@localhost:5432/communication_system

# --- Storage (MinIO local) --------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio_access
STORAGE_SECRET_KEY=minio_secret
STORAGE_BUCKET=cs-attachments
STORAGE_REGION=us-east-1

# --- Frontend ---------------------------------------------------------------
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_MOCK_IDP_URL=http://localhost:4001

# --- Webhooks ---------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=dev_webhook_signing_secret_change_in_production
MOCK_WEBHOOK_PORT=4002

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ----------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
