FROM node:22.12.0-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/contracts/package.json ./packages/contracts/
COPY apps/mock-webhook/package.json ./apps/mock-webhook/
RUN pnpm install --frozen-lockfile

FROM base AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY tsconfig.base.json ./
COPY packages/contracts ./packages/contracts
COPY apps/mock-webhook ./apps/mock-webhook
RUN pnpm --filter @cs/contracts build && \
    pnpm --filter @cs/mock-webhook build

FROM node:22.12.0-alpine AS runner
RUN addgroup -S cs && adduser -S cs -G cs
WORKDIR /app
COPY --from=build --chown=cs:cs /app/apps/mock-webhook/dist ./apps/mock-webhook/dist
COPY --from=build --chown=cs:cs /app/apps/mock-webhook/node_modules ./apps/mock-webhook/node_modules
COPY --from=build --chown=cs:cs /app/apps/mock-webhook/package.json ./apps/mock-webhook/
USER cs
EXPOSE 4002
CMD ["node", "apps/mock-webhook/dist/index.js"]
