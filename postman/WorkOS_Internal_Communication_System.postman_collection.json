{
  "info": {
    "name": "WorkOS Internal Communication System API",
    "description": "Comprehensive Postman collection for the standalone WorkOS Internal Communication System REST API (31 endpoints).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "health"]
            }
          }
        },
        {
          "name": "Acceptance Demonstration Suite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vedantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/acceptance/run",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "acceptance", "run"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth & Identity",
      "item": [
        {
          "name": "Get Current User Profile & Claims",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vedantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Exchange WorkOS Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{vedantToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/exchange",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "exchange"]
            }
          }
        }
      ]
    },
