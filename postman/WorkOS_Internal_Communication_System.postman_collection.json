          }
        },
        {
          "name": "Tenant Message Search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vedantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/search?q=Apollo&type=messages",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "search"],
              "query": [
                {
                  "key": "q",
