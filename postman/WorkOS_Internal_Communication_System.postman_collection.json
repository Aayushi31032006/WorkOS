    {
      "name": "Audit & Search",
      "item": [
        {
          "name": "Query Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vedantToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/audit?limit=25",
              "host": ["{{baseUrl}}"],
