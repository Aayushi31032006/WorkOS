# API service environment -- copy to .env for local development
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://app_user:app_pass@localhost:5432/communication_system
MIGRATION_DATABASE_URL=postgresql://cs_user:cs_pass@localhost:5432/communication_system
JWKS_URI=http://localhost:4001/.well-known/jwks.json
JWT_AUDIENCE=communication-system
JWT_ISSUER=http://localhost:4001
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minio_access
STORAGE_SECRET_KEY=minio_secret
STORAGE_BUCKET=cs-attachments
STORAGE_REGION=us-east-1
CORS_ORIGINS=http://localhost:5173
WEBHOOK_SIGNING_SECRET=dev_webhook_signing_secret_change_in_production
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
