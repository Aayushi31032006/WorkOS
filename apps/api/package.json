{
  "name": "@cs/api",
  "version": "0.1.0",
  "description": "Fastify HTTP + WebSocket backend – implemented in Stage 2",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:integration": "vitest run --reporter=verbose",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@cs/contracts": "workspace:*",
    "@cs/test-fixtures": "workspace:*",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}

